{
  "kind": "collectionType",
  "collectionName": "queues",
  "info": {
    "singularName": "queue",
    "pluralName": "queues",
    "displayName": "Queue"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "joinedAt": {
      "type": "datetime",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["waiting", "playing", "finished"],
      "default": "waiting",
      "required": true
    }
  }
}
